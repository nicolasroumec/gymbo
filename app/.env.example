# Copiar a .env.local y completar con los valores de Supabase (Project Settings > API Keys).
# La clave publicable es pública por diseño: la protección real es RLS.
# Nunca poner acá la secret key ni la service_role.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
